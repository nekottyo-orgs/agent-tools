      else to_cur m Res.None
    | Place.Cur => ok Outcome.Unchanged
  | Op.AckNoReply =>
    match m.place with
    | Place.New =>
      match m.tag with
      | Tag.Escalation => ok (Outcome.Refused Refusal.NeedsReply)
      | Tag.Request => ok (Outcome.Refused Refusal.NeedsReply)
      | Tag.Alert => to_cur m Res.NoReply
      | Tag.Completion => to_cur m Res.NoReply
      | Tag.Progress => to_cur m Res.NoReply
      | Tag.Reply => to_cur m Res.NoReply
      | Tag.Info => to_cur m Res.NoReply
      | Tag.Conflict => to_cur m Res.NoReply
      | Tag.Other => to_cur m Res.NoReply
    | Place.Held =>
      match m.tag with
      | Tag.Escalation => ok (Outcome.Refused Refusal.NeedsReply)
      | Tag.Request => ok (Outcome.Refused Refusal.NeedsReply)
      | Tag.Alert => to_cur m Res.NoReply
      | Tag.Completion => to_cur m Res.NoReply
      | Tag.Progress => to_cur m Res.NoReply
      | Tag.Reply => to_cur m Res.NoReply
      | Tag.Info => to_cur m Res.NoReply
