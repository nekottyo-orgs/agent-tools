    Visibility: public -/
def plan (m : Msg) (op : Op) (o : Obs) : Result (alloc.vec.Vec Effect) := do
  let o1 ← step m op o
  match o1 with
  | Outcome.Moved _ =>
    match op with
    | Op.Ack => push_move (alloc.vec.Vec.new Effect) m.place Place.Cur
    | Op.AckNoReply =>
      let v ←
        alloc.vec.Vec.push (alloc.vec.Vec.new Effect) (Effect.AppendLog
          Log.NoReply)
      push_move v m.place Place.Cur
    | Op.AckSenderGone =>
      let v ←
        alloc.vec.Vec.push (alloc.vec.Vec.new Effect) (Effect.AppendLog
          Log.NoReply)
      push_move v m.place Place.Cur
    | Op.Reply =>
      let v ← push_move (alloc.vec.Vec.new Effect) m.place Place.Cur
      alloc.vec.Vec.push v (Effect.AppendLog Log.Replied)
    | Op.Hold =>
      let v ← alloc.vec.Vec.push (alloc.vec.Vec.new Effect) Effect.WriteWait
      let v1 ← alloc.vec.Vec.push v (Effect.MoveTo Place.Held)
      alloc.vec.Vec.push v1 (Effect.AppendLog Log.Held)
  | Outcome.Unchanged =>
    match op with
    | Op.Ack => ok (alloc.vec.Vec.new Effect)
    | Op.AckNoReply => ok (alloc.vec.Vec.new Effect)
    | Op.AckSenderGone => ok (alloc.vec.Vec.new Effect)
    | Op.Reply =>
      alloc.vec.Vec.push (alloc.vec.Vec.new Effect) (Effect.AppendLog
        Log.Replied)
    | Op.Hold => alloc.vec.Vec.push (alloc.vec.Vec.new Effect) Effect.WriteWait
  | Outcome.Refused _ => ok (alloc.vec.Vec.new Effect)

