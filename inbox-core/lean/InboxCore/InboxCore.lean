        if f.idle
        then
          if f.req_accepted
          then
            if f.waiting
            then ok (f.remaining, false)
            else
              if f.close_failed
              then ok (f.remaining, false)
              else
                match f.remaining with
                | Remaining.Empty => ok (Remaining.Empty, false)
                | Remaining.Nothing => ok (Remaining.Nothing, true)
                | Remaining.Other => ok (Remaining.Other, false)
          else ok (f.remaining, false)
        else ok (f.remaining, false)
      else ok (f.remaining, false)
    else ok (f.remaining, false)
  let b ←
    match «from» with
    | Lane.Todo => ok false
    | Lane.Worker => ok true
    | Lane.HumanDecision => ok false
    | Lane.HumanAction => ok false
    | Lane.Done => ok false
  let (p1, c_pane_gone) ←
    if b
    then
      do
      let b1 ←
        match p with
        | Panes.Unknown => ok false
        | Panes.Absent => ok true
        | Panes.Closed => ok false
        | Panes.Live => ok false
      ok (p, b1)
    else ok (p, false)
  let b1 ←
    match «from» with
    | Lane.Todo => ok false
    | Lane.Worker => ok false
    | Lane.HumanDecision => ok true
    | Lane.HumanAction => ok false
    | Lane.Done => ok false
  let c_answered ←
    if b1
    then if f.answered
         then ok (¬ f.waiting)
         else ok false
    else ok false
  let c_waiting ←
    if tw
    then if live
         then ok f.waiting
         else ok false
    else ok false
  let b2 ←
    match «from» with
    | Lane.Todo => ok false
    | Lane.Worker => ok true
    | Lane.HumanDecision => ok false
    | Lane.HumanAction => ok false
    | Lane.Done => ok false
  let c_stall ←
    if b2
    then
      if live
      then
        if f.idle
        then over_cap { f with panes := p1, remaining := r } now cap_min
        else ok false
      else ok false
    else ok false
  let b3 ←
    match «from» with
    | Lane.Todo => ok true
    | Lane.Worker => ok false
    | Lane.HumanDecision => ok false
    | Lane.HumanAction => ok false
    | Lane.Done => ok false
  let c_live ←
    if b3
    then
      if live
      then
        do
        let b4 ← if f.answered
                   then ok (¬ f.working)
                   else ok false
        ok (¬ b4)
      else ok false
    else ok false
  if c_settle_gone
  then
    match r with
    | Remaining.Empty =>
      ok (some { rule := Rule.SettleGone, dest := Lane.Done })
    | Remaining.Nothing =>
      ok (some { rule := Rule.SettleGone, dest := Lane.Done })
    | Remaining.Other =>
      if f.waiting
      then ok (some { rule := Rule.SettleGone, dest := Lane.HumanDecision })
      else ok (some { rule := Rule.SettleGone, dest := Lane.HumanAction })
  else
    if c_settle_done
    then ok (some { rule := Rule.SettleDone, dest := Lane.Done })
    else
      if c_pane_gone
      then ok (some { rule := Rule.PaneGone, dest := Lane.Todo })
      else
        if c_answered
        then ok (some { rule := Rule.Answered, dest := Lane.Todo })
        else
          if c_waiting
          then ok (some { rule := Rule.Waiting, dest := Lane.HumanDecision })
          else
            if c_stall
            then ok (some { rule := Rule.StallCap, dest := Lane.HumanAction })
            else
              if c_live
              then ok (some { rule := Rule.Live, dest := Lane.Worker })
              else ok none

