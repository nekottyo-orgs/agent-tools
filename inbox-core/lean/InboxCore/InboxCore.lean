def over_cap
  (f : TaskFacts) (now : Std.U64) (cap_min : Std.U64) : Result Bool := do
  if f.detected
  then
    if f.seen
    then
      if f.cleared
      then ok false
      else
        let i ← cap_min * 60#u64
        let i1 ← f.detected_at + i
        ok (now >= i1)
    else ok false
  else ok false

